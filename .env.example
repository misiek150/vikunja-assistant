# Logging: "console" (stdout only) or "seq" (stdout + Seq)
LOG_MODE=console
LOG_LEVEL=INFO
SEQ_URL=
SEQ_API_KEY=

# When true, Gemini is not called; canned/mock responses are used
MOCK_MODE=true
# Optional: <image stem>.json files with mock Gemini responses
MOCK_RESPONSES_DIR=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

VIKUNJA_BASE_URL=http://localhost:3456
VIKUNJA_API_TOKEN=
VIKUNJA_PROJECT_ID=1

SCREENSHOTS_DIR=./data/screenshots
# Defaults to <SCREENSHOTS_DIR>/processed
PROCESSED_DIR=
